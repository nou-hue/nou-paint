# Nou Paint: payments are TEST MODE ONLY. Set these on Vercel Preview/Development only.
# Never commit real values. Nothing here is required for kids pages, which are free and anonymous.

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx            # one-off TEST price; shown in the UI, read from Stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx
# ALLOW_LIVE_STRIPE=                 # leave UNSET. A sk_live_ key is refused without it.

# --- Entitlement cookie signing (min 32 chars, e.g. `openssl rand -base64 48`) ---
ENTITLEMENT_COOKIE_SECRET=

# --- Public origin used in Stripe return URLs and emails ---
SITE_URL=https://your-preview-host.vercel.app

# --- Restore-by-email + confirmation email (Resend). Omit to hide the restore form. ---
RESEND_API_KEY=
EMAIL_FROM="Nou Paint <orders@example.com>"

# --- Pre-order summary (reg 14(2)). Unset values show as visible [PLACEHOLDERS]. ---
PACK_FEATURE_LIST=
PACK_DURATION=
VAT_STATEMENT=

# --- Seller identity, refund wording (confirmation email). Unset => placeholders. ---
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_CONTACT_EMAIL=
SELLER_PHONE=
SELLER_VAT_NUMBER=
REFUND_POLICY_TEXT=
TERMS_TEXT=

# --- Optional ---
# CHECKOUT_SUBMIT_TEXT=              # custom text under the Stripe pay button
